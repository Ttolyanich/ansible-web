# Flask Secret Key
SECRET_KEY=change-this-to-a-very-secure-random-string

# Fernet 32-byte urlsafe base64 key for SQLite secret encryption
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-32-byte-base64-key-here

# Database configuration
DATABASE_URL=sqlite:///instance/ansible_web.db

# Ansible performance tuning
ANSIBLE_FORKS=50
ANSIBLE_TIMEOUT=5

# Application Port & Binding
# Use 127.0.0.1 to restrict access to localhost only (via SSH tunnel or Nginx reverse proxy)
# Use 0.0.0.0 to allow direct connections to host IP
BIND_ADDRESS=127.0.0.1
PORT=5050

# Optional service accounts exclusion for Windows inactive user disabler (comma-separated)
# Or place them in instance/service_accounts.txt (ignored by Git)
INACTIVE_USERS_SERVICE_EXCLUSIONS=Administrator,Guest,DefaultAccount

# ==============================================================================
# Доменная авторизация Active Directory (LDAP)
# ==============================================================================
# Включить авторизацию через AD (true / false).
# Локальные пользователи панели (например, резервный admin) продолжают работать параллельно.
LDAP_ENABLED=false

# Адрес контроллера домена (например: ldap://10.11.4.254 или ldaps://dc.corp.local)
LDAP_SERVER=ldap://10.11.4.254
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_DOMAIN=corp.local
LDAP_BASE_DN=DC=corp,DC=local

# Сервисная учетная запись для поиска пользователей по email / UPN / sAMAccountName (Search-then-Bind)
# Если не указана, используется прямой вход (Direct Bind)
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# Обязательная группа доступа (если задана, войти смогут только участники этой группы AD)
LDAP_REQUIRED_GROUP=

# Маппинг ролей по группам безопасности Active Directory:
# Участники этих групп автоматически получают соответствующую роль при входе:
LDAP_ADMIN_GROUP=Domain Admins
LDAP_LINUX_ADMIN_GROUP=Linux-Engineers
LDAP_WINDOWS_ADMIN_GROUP=Windows-Engineers
LDAP_OPERATOR_GROUP=DevOps-Operators
LDAP_AUDITOR_GROUP=Security-Auditors

# Явное указание конкретных пользователей (логины или email через запятую):
# Позволяет выдать роль конкретным инженерам без изменения групп в AD
LDAP_ADMIN_USERS=admin,sysadmin,lead@corp.local
LDAP_LINUX_ADMIN_USERS=
LDAP_WINDOWS_ADMIN_USERS=
LDAP_OPERATOR_USERS=
LDAP_AUDITOR_USERS=

# Роль по умолчанию для авторизованных доменных пользователей, не попавших в спец. группы:
# Варианты: admin, linux_admin, windows_admin, operator, auditor
LDAP_DEFAULT_ROLE=operator

# Проверять вложенные (рекурсивные) группы Active Directory (LDAP_MATCHING_RULE_IN_CHAIN)
LDAP_NESTED_GROUPS=true
LDAP_TIMEOUT=5

